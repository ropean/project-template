# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Ecosystems whose official style is 4 spaces.
[*.{py,php,cs,java,kt,kts,rs,swift,gradle}]
indent_size = 4

# Ecosystems that require tabs.
[{Makefile,*.mk,*.go,go.mod,go.work}]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
