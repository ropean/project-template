# Normalize line endings: LF in the repo and in every working tree,
# so shell scripts and Dockerfiles keep working when checked out on Windows.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Lockfiles: generated, so hide them from diffs and GitHub language stats.
pnpm-lock.yaml   -diff linguist-generated
package-lock.json -diff linguist-generated
bun.lock         -diff linguist-generated
yarn.lock        -diff linguist-generated
composer.lock    -diff linguist-generated
Cargo.lock       -diff linguist-generated
go.sum           -diff linguist-generated
poetry.lock      -diff linguist-generated
uv.lock          -diff linguist-generated

# Binary files: never touch line endings, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.7z    binary
*.rar   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.wasm  binary
*.sqlite binary
*.db    binary
*.bcmap binary
