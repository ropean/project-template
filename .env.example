# Copy to `.env` for local development. On the server, `.env` lives in
# SSH_DEPLOY_PATH next to docker-compose.yml (see docs/deployment.md).
# Never commit `.env`; keep this file in sync with every variable the app reads.

# Host port the container is published on (bound to 127.0.0.1 only).
APP_PORT=3000

# Public URL the app is reached at (used for absolute links and OAuth redirects).
PUBLIC_ORIGIN=http://localhost:3000

# SSO / OIDC: see docs/integrations/sso-oidc.md before adding variables here.
